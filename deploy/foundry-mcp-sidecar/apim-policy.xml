<!--
  raucle sidecar — APIM inbound policy for Azure AI Foundry MCP routing.

  What this policy DOES (and nothing more):
    1. Routes the APIM operation it is applied to, to the configured
       backend service URL.
    2. Propagates agent, token, correlation and receipt headers.
    3. Implements the direct-route guard: an inbound request whose Host
       header names the MCP backend host directly is denied with a named
       403 before routing happens (defence in depth at the visible
       control point).
    4. Fails closed with a structured 503 when the backend service
       errors (on-error block).

  What this policy does NOT do: it emits no receipts and runs no gate.
  Receipt emission and tool-call gating are contracts of the raucle
  sidecar in the PROPOSED integration described in
  deploy/foundry-mcp-sidecar/README.md - the guard here complements,
  and never replaces, the MCP server's network rule, which is the
  primary no-bypass control. The four-header contract below binds the
  agent runtime to the proposed sidecar behaviour.

  Replacement tokens — set these as APIM Named Values before applying:

    {{raucle-sidecar-fqdn}}       FQDN of the raucle sidecar Container
                                  App, e.g.
                                  raucle-sidecar.internal.azurecontainerapps.io
    {{raucle-mcp-path}}           Path prefix at which the sidecar mounts
                                  the MCP forwarder, defaults to /mcp
    {{raucle-mcp-backend-host}}  The MCP server's own hostname (e.g.
                                  mcp.customer.example.com). The Bicep
                                  template provisions this named value
                                  from the mcpBackendUrl parameter.

  Companion docs:
    - deploy/foundry-mcp-sidecar/README.md   (customer-facing walkthrough)
    - deploy/foundry-mcp-sidecar/bicep/main.bicep
    - docs/proposals/foundry-mcp-gateway.md  (design rationale)
-->
<policies>
  <inbound>
    <base />

    <!-- 1. Force-route to the raucle sidecar. The sidecar terminates
         the MCP request, runs the gate, and either forwards to the
         customer's MCP backend or returns a JSON-RPC error. -->
    <set-backend-service
        base-url="https://{{raucle-sidecar-fqdn}}{{raucle-mcp-path}}" />

    <!-- 2. Propagate Foundry's Entra agent identity into the receipt's
         agent_id field. APIM resolves Foundry's managed-identity
         credentials into context.User.Id before this policy fires.
         The sidecar reads this header and uses it verbatim. -->
    <set-header name="X-Raucle-Agent-Id" exists-action="override">
      <value>@(("agent:" + (context.User?.Id ?? "unknown")).Trim())</value>
    </set-header>

    <!-- 3. Propagate the in-force capability token id. The agent's
         session bootstrap mints the token at session-open time and
         must forward this header on every tool invocation. If the
         header is absent the sidecar fails closed (no token -> DENY). -->
    <set-header name="X-Raucle-Token-Id" exists-action="skip">
      <value>@{
        var hdr = context.Request.Headers.GetValueOrDefault("X-Raucle-Token-Id", "");
        return string.IsNullOrEmpty(hdr) ? "" : hdr;
      }</value>
    </set-header>

    <!-- 4. Propagate Foundry's correlation id so the sidecar's receipt
         and the APIM-side audit can be joined by a third-party
         verifier. APIM injects context.RequestId by default; we just
         normalise the header name. -->
    <set-header name="X-Raucle-Correlation-Id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>

    <!-- 5. Direct-route guard (Q21, external phase-22 review). Deny
         requests that name the MCP backend's hostname directly before
         any routing happens: a request arriving at this operation whose
         Host header matches the MCP server's own hostname indicates a
         direct route pointed at the backend rather than the
         sidecar-routed operation, and letting it through would leave
         gaps in the receipt chain. APIM denies it with a named 403.

         Expression validity, per the APIM policy expression reference:
         context.Request.Headers.GetValueOrDefault and the
         {{named-value}} interpolation inside a @(...) expression are the
         documented patterns (named values in string literals inside
         expressions resolve before evaluation). Deploy-time syntax
         cannot be validated offline - per the Microsoft reference,
         policy expressions get only limited verification when the
         policy is defined and run at gateway run-time - so verify at
         deploy time: save this policy against a development APIM
         instance (the portal validates XML well-formedness on save),
         then with the API trace enabled exercise both paths - a normal
         sidecar-routed call (must route through) and a direct-call
         attempt naming the backend host (must return the 403 denial
         below). The direct-call attempt failing is the deployment
         acceptance row of the external review; see README "Deployment
         acceptance".

         The comparison is a case-insensitive Contains on the Host
         header: a Host that merely names the backend host (with or
         without a port, or inside a longer crafted host string) denies
         too — the guard fails closed, and the network rule is the
         primary control.

         Residual, stated plainly: this guard covers requests that reach
         THIS operation; it does not cover direct network paths to the
         MCP backend that bypass APIM entirely - the MCP server's
         inbound network rules remain the primary no-bypass control. -->
    <choose>
      <when condition='@(context.Request.Headers.GetValueOrDefault("Host", "").Trim().ToLowerInvariant().Contains("{{raucle-mcp-backend-host}}".ToLowerInvariant()))'>
        <return-response>
          <set-status code="403" reason="raucle direct-route denied" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="X-Raucle-Correlation-Id" exists-action="override">
            <value>@(context.RequestId.ToString())</value>
          </set-header>
          <set-body>{"jsonrpc": "2.0", "error": {"code": -32098, "message": "direct route to the MCP backend is denied; calls must enter through the sidecar-routed operation", "data": {"raucle": "direct_route_denied", "correlation_id": "@(context.RequestId.ToString())"}}}</set-body>
        </return-response>
      </when>
    </choose>
  </inbound>

  <backend>
    <forward-request timeout="30"
                     buffer-request-body="true"
                     buffer-response="true" />
  </backend>

  <outbound>
    <base />
    <!-- Echo the sidecar's receipt id back to Foundry as a response
         header so the agent runtime can correlate the call with its
         receipt. Optional for production but useful for debugging. -->
    <set-header name="X-Raucle-Receipt-Id" exists-action="skip">
      <value>@(context.Response.Headers.GetValueOrDefault("X-Raucle-Receipt-Id", ""))</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
    <!-- If the sidecar is unreachable or returns 5xx, fail closed:
         return a structured error to Foundry rather than silently
         falling through to the MCP backend without a receipt. -->
    <choose>
      <when condition='@(context.LastError.Source == "set-backend-service" || (context.Response?.StatusCode >= 500))'>
        <return-response>
          <set-status code="503" reason="raucle sidecar unavailable" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{
  "jsonrpc": "2.0",
  "error": {
    "code": -32099,
    "message": "raucle policy gate unavailable; failing closed",
    "data": {
      "raucle": "fail_closed",
      "correlation_id": "@(context.RequestId.ToString())"
    }
  }
}</set-body>
        </return-response>
      </when>
    </choose>
  </on-error>
</policies>
