# Production environment for the raucle gateway.
#
# Copy to /etc/raucle/prod.env (chmod 600) and keep it OUTSIDE the git
# checkout: `git reset --hard` during a deploy must never be able to revert a
# production secret. The compose overlay reads this file through `env_file:`,
# and compose INTERPOLATION-time variables also need `set -a; . <file>; set +a`
# before any `docker compose` call.
#
# Every variable below names its contract. Read the field in
# raucle/gateway.py (GatewayConfig.from_env) before changing a value: several
# are file PATHS, not booleans, and a plausible-looking `1` writes a file
# literally named `1`.

# --- Bootstrap admin -------------------------------------------------------
# RAUCLE_ADMIN_KEY_FILE wins over RAUCLE_ADMIN_KEY when both are set. The
# bootstrap admin is created only when the user store holds no admin, so a
# rotated key does not silently add a second one.
RAUCLE_ADMIN_KEY_FILE=/run/secrets/raucle_admin_key
# RAUCLE_ADMIN_KEY=

# --- Public demo -----------------------------------------------------------
# A demo key is an auditor key with read access to the whole receipt chain.
# It is served by /api/demo-key ONLY when RAUCLE_DEMO_MODE is on (RED-035),
# and only registered as a user under the same condition. On a customer
# instance, leave both unset.
RAUCLE_DEMO_KEY_FILE=/run/secrets/raucle_demo_key
RAUCLE_DEMO_MODE=1

# --- Gate authentication ---------------------------------------------------
# off    = the agent_id the caller declares IS the identity written into the
#          receipt chain. Trusted internal networks only.
# apikey = per-agent credential from the credential store.
# token  = capability token, verified against the trust registry.
RAUCLE_GATE_AUTH=apikey

# --- Rate limiting ---------------------------------------------------------
# /gate carries its own per-route limit (RED-037); everything else uses the
# default. The key is the socket peer unless RAUCLE_TRUST_PROXY is set, so a
# fleet behind one proxy shares one bucket: a demo or load generator needs a
# generous route limit or it throttles itself.
RAUCLE_GATE_ROUTE_LIMIT=200/minute
RAUCLE_GATE_RATE_LIMIT=1000/minute
# Set to 1 ONLY when the gateway is reachable exclusively through a proxy
# that sets X-Forwarded-For. Trusting it while the port is open lets a caller
# pick its own rate-limit bucket.
# RAUCLE_TRUST_PROXY=1

# --- Evidence paths --------------------------------------------------------
# These decide where evidence lands. Changing them through the admin API
# requires the admin role and they must resolve inside RAUCLE_DATA_ROOT
# (RED-035), default the parent of the receipt store.
RAUCLE_DATA_ROOT=/data
RAUCLE_RECEIPT_STORE_DIR=/data/receipts
RAUCLE_RECEIPT_INDEX_PATH=/data/receipts/index.sqlite
RAUCLE_AUDIT_CHAIN=/data/audit.jsonl
RAUCLE_POLICY_FILE=/etc/raucle/policies.yaml
# A PATH, not a boolean (empty disables). A value of `1` writes a file named 1.
RAUCLE_POLICY_LEDGER=/data/policy-ledger.jsonl
# When set, the enforcement files are re-hashed against the receipted
# activation seal at every gate entry, and a divergence denies fail-closed.
# RAUCLE_POLICY_SEAL_FILE=/data/policy-seal.json
RAUCLE_REGISTRY_PATH=/data/registry.jsonl
RAUCLE_REVOCATIONS_FILE=/data/revocations.jsonl
RAUCLE_DELEGATIONS_FILE=/data/delegations.jsonl
RAUCLE_SIGNER_KEY_PATH=/data/gateway-signing-key.pem

# --- Signing ---------------------------------------------------------------
# local | aws | azure | vault
RAUCLE_SIGNER=local

# --- Health ----------------------------------------------------------------
# When set, /health requires this token on both apps.
# RAUCLE_HEALTH_KEY=

# --- SIEM ------------------------------------------------------------------
# The target is validated on write and at forward time: http(s), no loopback,
# link-local or private literal addresses (RED-036). Opt in deliberately for
# an internal collector.
RAUCLE_SIEM_ENABLED=false
RAUCLE_SIEM_BACKEND=
RAUCLE_SIEM_URL=
RAUCLE_SIEM_TOKEN=
# RAUCLE_SIEM_ALLOW_PRIVATE=1

# ---------------------------------------------------------------------------
# DEV-ONLY: gate chaos mode (EPIC S5). Never production.
# RAUCLE_CHAOS=1 with RAUCLE_ENV=dev injects named evidence-write faults
# (drop_receipt, delay_index_write, misorder_chain). The gateway REFUSES
# to enable chaos when RAUCLE_GATE_AUTH is not "off", so a production
# gateway (auth=apikey or token) never carries fault injection.
# RAUCLE_CHAOS=1
# RAUCLE_CHAOS_FAULTS=drop_receipt,delay_index_write,misorder_chain
# ---------------------------------------------------------------------------
