# Production environment for the raucle gateway.
#
# Copy to /etc/raucle/prod.env (chmod 600) and keep it OUTSIDE the git
# checkout: `git reset --hard` during a deploy must never be able to revert a
# production secret. The compose overlay reads this file through `env_file:`,
# and compose INTERPOLATION-time variables also need `set -a; . <file>; set +a`
# before any `docker compose` call.
#
# Every variable below names its contract. Read the field in
# raucle/gateway.py (GatewayConfig.from_env) before changing a value: several
# are file PATHS, not booleans, and a plausible-looking `1` writes a file
# literally named `1`.

# --- Bootstrap admin -------------------------------------------------------
# RAUCLE_ADMIN_KEY_FILE wins over RAUCLE_ADMIN_KEY when both are set. The
# bootstrap admin is created only when the user store holds no admin, so a
# rotated key does not silently add a second one.
RAUCLE_ADMIN_KEY_FILE=/run/secrets/raucle_admin_key
# RAUCLE_ADMIN_KEY=

# --- Public demo -----------------------------------------------------------
# A demo key is an auditor key with read access to the whole receipt chain.
# It is served by /api/demo-key ONLY when RAUCLE_DEMO_MODE is on (RED-035),
# and only registered as a user under the same condition. On a customer
# instance, leave both unset.
RAUCLE_DEMO_KEY_FILE=/run/secrets/raucle_demo_key
RAUCLE_DEMO_MODE=1

# --- Gate authentication ---------------------------------------------------
# off    = the agent_id the caller declares IS the identity written into the
#          receipt chain. Trusted internal networks only.
# apikey = per-agent credential from the credential store.
# token  = capability token, verified against the trust registry.
RAUCLE_GATE_AUTH=apikey

# --- Rate limiting ---------------------------------------------------------
# /gate carries its own per-route limit (RED-037); everything else uses the
# default. The key is the socket peer unless RAUCLE_TRUST_PROXY is set, so a
# fleet behind one proxy shares one bucket: a demo or load generator needs a
# generous route limit or it throttles itself.
RAUCLE_GATE_ROUTE_LIMIT=200/minute
RAUCLE_GATE_RATE_LIMIT=1000/minute
# Set to 1 ONLY when the gateway is reachable exclusively through a proxy
# that sets X-Forwarded-For. Trusting it while the port is open lets a caller
# pick its own rate-limit bucket.
# RAUCLE_TRUST_PROXY=1

# --- Evidence paths --------------------------------------------------------
# These decide where evidence lands. Changing them through the admin API
# requires the admin role and they must resolve inside RAUCLE_DATA_ROOT
# (RED-035), default the parent of the receipt store.
RAUCLE_DATA_ROOT=/data
RAUCLE_RECEIPT_STORE_DIR=/data/receipts
RAUCLE_RECEIPT_INDEX_PATH=/data/receipts/index.sqlite

# --- Single-writer receipt sidecar (X3 slice 4) -----------------------------
# Set RAUCLE_RECEIPT_SIDECAR_URL on the gateway ONLY when a sidecar owns
# the chain; the two-writer guard refuses to boot a gateway configured
# with BOTH a sidecar URL and the local store rows above. The sidecar
# reads the same secret. The shared secret authenticates the sidecar's
# callers as this deployment's own gateways: it is not a capability and
# the sidecar must never be reachable outside the trusted segment.
# RAUCLE_RECEIPT_SIDECAR_URL=http://127.0.0.1:8092
# RAUCLE_RECEIPT_SIDECAR_SECRET=   # REQUIRED on both processes; never argv
# RAUCLE_RECEIPT_SIDECAR_TIMEOUT=2.0
# RAUCLE_RECEIPT_SIDECAR_MAX_QUEUE=4096   # sidecar only; overflow refusal past this

# --- Session behavioural windows (EPIC Q lane Q-2) -------------------------
# Bounds for the in-memory window the deterministic session rules evaluate
# over (bounded by design; a rule window wider than the TTL is a config
# error, fail-closed). TTL bounds each session key's history in time,
# max keys bounds live (session, agent) windows, max entries bounds one
# key against a hot session. Restarts replay the window from the receipt
# index within the TTL.
RAUCLE_SESSION_WINDOW_TTL_SECONDS=900
RAUCLE_SESSION_WINDOW_MAX_KEYS=1024
RAUCLE_SESSION_WINDOW_MAX_ENTRIES=10000

# --- Boot streaming (L1) and the boot memory ceiling (J1) ------------------
# The boot's resident memory is bounded by configuration, not by store
# size. RAUCLE_BOOT_MEM_CEILING_MB (0 = derive from detected memory
# minus a quarter, never below 2 GB) is the refusal ceiling the preflight
# projects against and the runtime watchdog samples; the budget it
# projects is baseline + scan window + index cache, so shrinking the
# windows lowers the projection for the same refusal guarantee. The
# scan window is W_replay, the bounded read window the boot's tail
# resume, chain scan and rebuild feeding share (64 MiB); the index
# cache is the SQLite page cache cap for the receipt index, with mmap
# off so resident size never tracks the file (64 MiB). Defaults are
# honestly pending the X5 bench re-derivation
# (docs/nfr/boot-streaming-v1.md); a refusal names RAUCLE rotate-chain.
RAUCLE_BOOT_MEM_CEILING_MB=0
RAUCLE_BOOT_SCAN_WINDOW_MB=64
# Gateway process only: a receipt-sidecar deployment wires the sidecar's
# own index cache through the chart's --index-cache-mb instead.
RAUCLE_INDEX_CACHE_MB=64

RAUCLE_AUDIT_CHAIN=/data/audit.jsonl
RAUCLE_POLICY_FILE=/etc/raucle/policies.yaml
# A PATH, not a boolean (empty disables). A value of `1` writes a file named 1.
RAUCLE_POLICY_LEDGER=/data/policy-ledger.jsonl
# When set, the enforcement files are re-hashed against the receipted
# activation seal at every gate entry, and a divergence denies fail-closed.
# RAUCLE_POLICY_SEAL_FILE=/data/policy-seal.json
# RAU-02: the operator-signed policy-seal sidecar (<policy-file>.meta).
# required: an unsigned policy file refuses at boot (post-migration posture).
# advisory: unsigned policy boots with a named POLICY SEAL ADVISORY banner
#   (the default for one release cycle - generate seals now). A seal that is
#   present but does not match the bytes refuses in every mode.
# off: the mechanism is entirely inactive.
# RAUCLE_POLICY_SEALING=advisory
# File with the operator's Ed25519 PUBLIC PEM(s) (one path; several joined
# with ':'). Sealing: `raucle policy seal <file> --key <operator-private.pem>`.
# RAUCLE_POLICY_SEAL_PUBLIC_KEY=/data/seal-public.pem
RAUCLE_REGISTRY_PATH=/data/registry.jsonl
RAUCLE_REVOCATIONS_FILE=/data/revocations.jsonl
RAUCLE_DELEGATIONS_FILE=/data/delegations.jsonl
# Q11 enforcement modes: all opt-in and unset by default; the development
# affordances (unsigned chain warns and runs, depth-one delegations without
# a ledger) are unchanged when the flags are absent.
# RAUCLE_AUDIT_SINGLE_WRITER=1  # the operator promises one writer to the
# audit chain; a second writer refuses boot by name instead of forking it
# RAUCLE_REQUIRE_SIGNED_AUDIT=1  # boot refuses an unavailable signer or an
# unsigned audit genesis; raucle rotate-chain is the named recovery path
# RAUCLE_REQUIRE_ANCESTRY_RESOLVER=1  # boot refuses without the delegation
# ledger backing the ancestry resolver for delegation depth beyond one level
# Chart note (X3 slice 4): in sidecar mode the chart overrides this to
# the writable signer-key mount (/keys/gateway-signing-key.pem); an
# unwritable path here refuses the boot by name (signer_key_unwritable).
RAUCLE_SIGNER_KEY_PATH=/data/gateway-signing-key.pem

# --- Signing ---------------------------------------------------------------
# local | aws | azure | vault
RAUCLE_SIGNER=local

# --- Health ----------------------------------------------------------------
# When set, /health requires this token on both apps.
# RAUCLE_HEALTH_KEY=

# --- SIEM ------------------------------------------------------------------
# The target is validated on write and at forward time: http(s), no loopback,
# link-local or private literal addresses (RED-036). Opt in deliberately for
# an internal collector.
RAUCLE_SIEM_ENABLED=false
RAUCLE_SIEM_BACKEND=
RAUCLE_SIEM_URL=
RAUCLE_SIEM_TOKEN=
# RAUCLE_SIEM_ALLOW_PRIVATE=1

# ---------------------------------------------------------------------------
# DEV-ONLY: gate chaos mode (EPIC S5). Never production.
# RAUCLE_CHAOS=1 with RAUCLE_ENV=dev injects named evidence-write faults
# (drop_receipt, delay_index_write, misorder_chain). The gateway REFUSES
# to enable chaos when RAUCLE_GATE_AUTH is not "off", so a production
# gateway (auth=apikey or token) never carries fault injection.
# RAUCLE_CHAOS=1
# RAUCLE_CHAOS_FAULTS=drop_receipt,delay_index_write,misorder_chain
# ---------------------------------------------------------------------------
